# Ignore third-party clones and heavyweight assets - the repo must be public and must
# clearly show only what we built. Everything below is described by URL in the README instead.
_resources/
video/

# Generated / downloaded model assets
*.npz
*.bin
*.task
*.h5
testdata/
*.onnx
*.wasm
*.fbx
*.blend
*.blend1
*.ply
*.glb
app/public/fits*.json
pivot/*.pdf

# ONNX exports are ~60 MB of weights: regenerate with trackA-core/sparc_onnx.py.
# The write-up and results.json beside them are committed.
notebooks/sparc/*.onnx
notebooks/sparc/*.onnx.data
trackA-core/out/**/*.onnx
trackA-core/out/**/*.onnx.data

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.comfy
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Node / web
*node_modules/
*dist/
*.vite/
*.cache/
_data/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated media is never committed - but the markdown write-ups beside it always are.
*.wav
*.flac
*.mp3
*.mp4
renders/*.mp4
# Project-local caches (uv, HF, torch) - local by design, never committed
.cache/
.venv*/

# Third-party JS kept out of the public repo on purpose - see app/README.md
app/vendor/

# Vendor notebooks are third-party copies: scratch material, never committed.
# Our own notes and runner in that folder are kept.
notebooks/**/*.ipynb
notebooks/_exec/


# Local API credentials (never commit)
.env
.env.*
.cache/meta-api-key*

# Pivot project: our studio code is committed, the third-party clones and weights never are.
pivot/MHR/
pivot/sam-3d-body-dinov3/
pivot/sapiens2/
pivot/*.zip
pivot/**/assets/
pivot/**/checkpoints/

# Third-party clones that arrived in the 2026-10-31 scan: Meta model repos and the SAM 3D Body
# annotation dataset (LFS). Never committed.
pivot/mms-tts/
pivot/sam-3d-body/
pivot/sam-3d-body-vith/
pivot/sam-3d-body-dataset/

# MHR baked assets are generated from the 696 MB model; rebuild with pipeline/mhr/bake_mhr.py.
# The bake script, the asset contract (spec.md) and the README are committed.
pipeline/mhr/assets/
# Per-photo outputs (identity JSON + keypoint debug overlays, up to ~20 MB) are regenerated by
# pipeline/avatar/from_photo.py; the script and its README are committed.
pipeline/avatar/out/

# One-pager run outputs (per-run identity JSON, GLB, WAV, event log) are generated;
# the server, page and README are committed.
product/runs/
product/assets/

# ---------------------------------------------------------------------------
# 2026-11-05 cleanup: pivot workspace (40 GB) - code is committed selectively.
# ---------------------------------------------------------------------------
# Generated experiment media: the README write-ups beside them are committed.
trackA-core/out/**
!trackA-core/out/**/README.md
trackA-core/out/*.md

